# Copy to .env and chmod 600 .env. Only the model settings loader reads these values.
# Process environment takes precedence. No shell commands or variable expansion.
CHINA_STOCK_SIM_LLM_BASE_URL=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHINA_STOCK_SIM_LLM_API_KEY=
CHINA_STOCK_SIM_LLM_MODEL=qwen3.8-flash
# Set only when running an installed package outside this source checkout.
# CHINA_STOCK_SIM_ROOT=/absolute/path/to/simulate-china-stocks
